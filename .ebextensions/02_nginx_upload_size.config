# EB's default nginx config caps request bodies at 1MB, which rejects any
# profile picture upload above that even though the app itself allows up to
# MAX_PROFILE_PICTURE_SIZE (2MB, see config/settings.py). Raise nginx's limit
# a little above the app's own limit so the app's own error message (not a
# generic nginx 413) is what the user sees for an oversized file.
files:
  "/etc/nginx/conf.d/01_upload_size.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 3M;
