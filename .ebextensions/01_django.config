option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: config.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
  03_sqlite_permissions:
    # Only matters while an environment runs on SQLite (no DATABASE_ENGINE set):
    # migrate runs as root, but the app runs as the webapp user and must be able to write the DB.
    command: "if [ -f db.sqlite3 ]; then chown webapp:webapp db.sqlite3 . ; fi"
