DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Optional: use Postgres instead of the default SQLite (e.g. for AWS RDS).
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=semesterpilot
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_SSLMODE=disable   # only for a local Postgres without SSL; defaults to require

# Email (password reset). Defaults to printing emails to the console in
# development — check the runserver output for the reset link. Set these
# for production so reset emails actually send.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@semesterpilot.app

# Deployment (set these as Elastic Beanstalk environment properties, not in .env)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=semesterpilot-prod.us-east-2.elasticbeanstalk.com
# DJANGO_CSRF_TRUSTED_ORIGINS=http://semesterpilot-prod.us-east-2.elasticbeanstalk.com
# DJANGO_SECURE_HTTPS=True   # only once the environment serves HTTPS
